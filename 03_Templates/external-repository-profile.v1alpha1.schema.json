{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-os://external-repository-profile/v1alpha1",
  "title": "External Repository Profile v1alpha1",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "governanceDocuments"
  ],
  "properties": {
    "apiVersion": {
      "const": "agent-os.external-repository-governance/v1alpha1"
    },
    "kind": {
      "const": "ExternalRepositoryProfile"
    },
    "governanceDocuments": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^(?!.*(?:authoriz|approv|ready|status|secret|credential|permission|deploy|production))[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/safeRelativePath"
      }
    }
  },
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\u0000)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  },
  "additionalProperties": false
}
