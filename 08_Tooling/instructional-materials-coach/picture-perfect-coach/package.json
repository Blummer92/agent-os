{
  "name": "@agent-os/picture-perfect-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "guard": "node scripts/guard-boundaries.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run guard"
  },
  "dependencies": {
    "@xstate/react": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xstate": "5.33.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
