{
  "name": "agent-os-teacher-os-first-slice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:app": "node server/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "playwright test",
    "test:unit": "node --experimental-strip-types --test --test-reporter=tap tests/unit/apiContract.test.ts tests/unit/fixtureContract.test.ts | node tests/unit/require-tests.mjs --min 50",
    "test:integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
