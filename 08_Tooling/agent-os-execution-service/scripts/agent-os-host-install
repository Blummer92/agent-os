#!/bin/sh
# Privileged Agent OS host-runtime installer (#1341).
#
# Installed out of band as root:root 0755 at
# /usr/local/libexec/agent-os-host-install. Every privileged step of the host
# runtime installation happens here and reads only from a root-owned staging
# directory that this script creates. No caller-supplied value is ever used as
# a path, so the unprivileged transport identity cannot substitute the code
# that runs as root.
#
# The only caller input is a 40-lowercase-hex commit that must already be an
# ancestor of canonical main in the fixed repository below.
set -eu

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

REPOSITORY_URL=https://github.com/Blummer92/agent-os.git
CANONICAL_BRANCH=main
STAGING_ROOT=/var/lib/agent-os/host-install-staging
TARGET=/usr/local/libexec/agent-os-governed-resume

fail() {
  printf '%s\n' "host runtime install refused: $1" >&2
  exit 64
}

if [ "$(id -u)" != "0" ]; then
  fail "privileged installer must run as root"
fi

if [ "$#" -ne 2 ] || [ "$1" != "--source-sha" ]; then
  fail "privileged installer argv must be exactly --source-sha <sha>"
fi
source_sha=$2
printf '%s\n' "$source_sha" | grep -Eq '^[0-9a-f]{40}$' ||
  fail "source SHA must be a lowercase 40-hex commit"

# Root-owned staging. Refuse rather than follow a symlink an attacker planted,
# and prove ownership/mode after creation rather than assuming it.
staging_parent=$(dirname "$STAGING_ROOT")
if [ -L "$staging_parent" ]; then
  fail "staging root must not be a symlink"
fi
mkdir -p "$staging_parent"
chown root:root "$staging_parent"
chmod 0755 "$staging_parent"

if [ -L "$STAGING_ROOT" ]; then
  fail "staging root must not be a symlink"
fi
rm -rf "$STAGING_ROOT"
mkdir "$STAGING_ROOT"
trap 'rm -rf "$STAGING_ROOT"' EXIT HUP INT TERM
chown root:root "$STAGING_ROOT"
chmod 0700 "$STAGING_ROOT"

staging_metadata=$(stat -c '%U:%G:%a' "$STAGING_ROOT")
[ "$staging_metadata" = "root:root:700" ] ||
  fail "staging root is not root-owned 0700"

checkout="$STAGING_ROOT/checkout"
wheel_dir="$STAGING_ROOT/wheels"

# Fixed URL, never a caller-supplied location.
git clone --quiet "$REPOSITORY_URL" "$checkout"
git -C "$checkout" merge-base --is-ancestor \
  "$source_sha" "origin/$CANONICAL_BRANCH" 2>/dev/null ||
  fail "source SHA is not on canonical main"
git -C "$checkout" checkout --quiet --detach "$source_sha"
head_sha=$(git -C "$checkout" rev-parse HEAD)
[ "$head_sha" = "$source_sha" ] ||
  fail "staged checkout does not match source SHA"

checkout_owner=$(stat -c '%U' "$checkout")
[ "$checkout_owner" = "root" ] || fail "staged tree must be root-owned"

apt-get install -y build-essential python3-dev >&2

mkdir "$wheel_dir"
chmod 0700 "$wheel_dir"
(
  cd "$checkout"
  python3 -m pip wheel --no-deps --wheel-dir "$wheel_dir" \
    ./08_Tooling/reusable-capability-registry \
    ./08_Tooling/agent-memory-context-manager \
    ./08_Tooling/workflow-scheduler \
    ./08_Tooling/agent-os-execution-service
) >&2

set -- "$wheel_dir"/reusable_capability_registry-*.whl
[ "$#" -eq 1 ] && [ -f "$1" ] || fail "expected one reusable-capability-registry wheel"
capability_wheel=$1
set -- "$wheel_dir"/agent_memory_context_manager-*.whl
[ "$#" -eq 1 ] && [ -f "$1" ] || fail "expected one agent-memory-context-manager wheel"
context_wheel=$1
set -- "$wheel_dir"/workflow_scheduler-*.whl
[ "$#" -eq 1 ] && [ -f "$1" ] || fail "expected one workflow-scheduler wheel"
scheduler_wheel=$1
set -- "$wheel_dir"/agent_os_execution_service-*.whl
[ "$#" -eq 1 ] && [ -f "$1" ] || fail "expected one agent-os-execution-service wheel"
service_wheel=$1

python3 -m pip install --break-system-packages --force-reinstall \
  "$capability_wheel" \
  "$context_wheel" \
  "$scheduler_wheel" \
  "$service_wheel" >&2

(
  cd /
  env -u PYTHONPATH python3 -c 'import agent_os_execution_service.handoff_discovery_entrypoint; import agent_os_execution_service.governed_resume_entrypoint; import workflow_scheduler.execution._clone3_cgroup'
) >&2

entrypoint_installer="$checkout/08_Tooling/agent-os-execution-service/scripts/install-governed-resume"
if [ -L "$entrypoint_installer" ]; then
  fail "staged entrypoint installer must not be a symlink"
fi
[ -f "$entrypoint_installer" ] || fail "staged entrypoint installer missing"

sh "$entrypoint_installer"
first_hash=$(sha256sum "$TARGET" | awk '{print $1}')
sh "$entrypoint_installer"
second_hash=$(sha256sum "$TARGET" | awk '{print $1}')
[ "$first_hash" = "$second_hash" ] || fail "entrypoint installer was not idempotent"

metadata=$(stat -c '%U:%G:%a' "$TARGET")
[ "$metadata" = "root:root:755" ] || fail "entrypoint owner/group/mode mismatch"

TARGET_HASH=$first_hash SOURCE_SHA=$head_sha STAGING_ROOT=$STAGING_ROOT python3 - <<'PY'
import json
import os

print(json.dumps({
    "status": "installed",
    "source_sha": os.environ["SOURCE_SHA"],
    "target": "/usr/local/libexec/agent-os-governed-resume",
    "owner": "root",
    "group": "root",
    "mode": "755",
    "sha256": os.environ["TARGET_HASH"],
    "staging_root": os.environ["STAGING_ROOT"],
    "privileged_source": "root-owned-staging",
    "discovery_importable": True,
    "governed_resume_importable": True,
    "native_extension_importable": True,
    "scheduler_invoked": False,
    "execution_authorized": False,
    "side_effects_performed": True,
}, sort_keys=True, separators=(",", ":")))
PY
