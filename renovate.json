{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": false,
  "dependencyDashboard": false,
  "enabledManagers": [
    "pep621",
    "pip_requirements",
    "npm"
  ],
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "05_Examples/**",
    "tests/fixtures/**"
  ],
  "packageRules": [
    {
      "description": "Nested-only surfaces. Root pip (requirements-dev.txt) and GitHub Actions stay with Dependabot — this config never touches them.",
      "groupName": "nested minor/patch",
      "matchPaths": [
        "08_Tooling/**",
        "src/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ]
    },
    {
      "description": "Major version upgrades stay separate for manual review",
      "labels": [
        "status:needs-decision"
      ],
      "matchPaths": [
        "08_Tooling/**",
        "src/**"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    }
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2
}
